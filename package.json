{
  "name": "arch-guard-mcp",
  "version": "1.0.0",
  "description": "Architecture drift auditor, zero-downtime SQL migration guardian, and deterministic distributed-systems math MCP server (local stdio + Cloudflare Workers Streamable HTTP) with cross-agent skills.",
  "type": "module",
  "main": "./src/index.mjs",
  "bin": {
    "arch-guard-mcp": "./bin/arch-guard-mcp.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./protocol": "./src/mcp/protocol.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "worker/",
    "skills/",
    "rules/",
    "assets/",
    "plugin.json",
    "mcp_config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/arch-guard-mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit:self": "node bin/cli.mjs audit .",
    "build:worker": "node scripts/bundle-worker.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "architecture",
    "system-design",
    "static-analysis",
    "sql-migrations",
    "expand-contract",
    "distributed-systems",
    "cloudflare-workers"
  ],
  "author": "Yashwant Rana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashwant938/arch-guard-mcp.git"
  },
  "homepage": "https://arch-guard-mcp.yashwant938.workers.dev",
  "engines": {
    "node": ">=20.0.0"
  }
}
